# Copy to .env on the Raspberry Pi (never commit the real .env)

AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
PW_CONTAINER=raw

# Location used by astral to compute civil twilight (dawn/dusk).
# Placeholder (Madrid): put the camera's coordinates here.
PW_LAT=40.4168
PW_LON=-3.7038
PW_TZ=Europe/Madrid
PW_MARGIN_MIN=15

# Resize/compression before uploading to Blob
PW_MAX_WIDTH=1600
PW_JPEG_QUALITY=80
# Clockwise rotation in degrees to straighten the photo: 0, 90, 180 or 270
PW_ROTATE=180
# Horizontal mirror after rotating (1 = yes, 0 = no)
PW_MIRROR=1

# Local spool for retries if the Blob upload fails
PW_SPOOL_DIR=./spool
PW_RETRY_EVERY_S=120
